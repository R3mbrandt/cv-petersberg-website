---
layout: layouts/page.njk
title: Ex-Prinzenpaare
kicker: Der Verein
description: Alle ehemaligen Prinzenmannschaften und Prinzenpaare des CVP – seit 1949.
breit: true
---
<ul class="prince-grid" role="list">
  {% for e in exprinzen %}
  <li class="prince-card" id="p{{ e.jahr | replace(' ', '') | replace('&', '-') }}">
    {% if e.bild %}{% set breite = e.bild | bildBreite %}{% if breite >= 700 %}<a class="zoom" href="{{ e.bild }}" data-lightbox="exprinzen" data-caption="{{ e.titel }}: {{ e.text }}" aria-label="Foto {{ e.titel }} vergrößern"><img src="{{ e.bild | thumb }}" alt="{{ e.titel }}" loading="lazy" decoding="async"></a>{% else %}<img src="{{ e.bild | thumb }}" alt="{{ e.titel }}" loading="lazy" decoding="async">{% endif %}{% endif %}
    <div class="prince-body">
      <p class="event-cat">{{ e.titel }}</p>
      <p>{{ e.text }}</p>
    </div>
  </li>
  {% endfor %}
</ul>

---
layout: layouts/base.njk
title: Carnevalverein Petersberg e.V.
bodyClass: home
---
{%- set kommend = termine | termineSortiert("kommend") %}
{%- set naechster = kommend[0] %}
{%- set haupt = collections.beitraege | beitragNach(startseite.hauptbeitrag) %}
<section class="hero">
  <div class="hero-confetti" aria-hidden="true">{% for i in range(0, 18) %}<i></i>{% endfor %}</div>
  <div class="container hero-grid">
    <div class="hero-copy">
      <p class="kicker">{{ kampagne.titel }}{% if kampagne.motto %} · „{{ kampagne.motto }}“{% endif %}</p>
      <h1 class="hero-title">{{ startseite.ueberschrift1 }}<br><span>{{ startseite.ueberschrift2 }}</span></h1>
      <p class="lead">{% if startseite.einleitung %}{{ startseite.einleitung }}{% else %}Seit dem {{ site.gruendungsdatum }} bringt der Carnevalverein Petersberg Garden, Sitzungen und gute Laune auf die Bühne – mit {{ site.mitglieder }} Mitgliedern und {{ gruppen | length }} Aktivengruppen und Tanzgarden.{% endif %}</p>
      <div class="btn-row">
        <a class="btn" href="/termine/">Alle Termine</a>
        <a class="btn btn-ghost" href="/mitmachen/">Mitglied werden</a>
      </div>
    </div>
    <div class="hero-visual">
      <img class="hero-logo" src="{{ site.logo }}" alt="Vereinslogo des {{ site.name }}" width="320" height="320">
      {% if naechster %}
      {#- Alle kommenden Termine für den Browser: er wählt selbst den nächsten aus,
          damit die Karte auch ohne nächtlichen Neubau aktuell bleibt. #}
      <script type="application/json" id="termine-daten">[
        {%- for t in kommend %}{"titel":{{ t.titel | json | safe }},"start":{{ t.datum | iso | json | safe }},"text":{{ ((t.datum | datum) + ((", " + (t.datum | uhrzeit)) if (t.datum | uhrzeit) else "")) | json | safe }}}{% if not loop.last %},{% endif %}{% endfor -%}
      ]</script>
      <a class="next-card" href="/termine/" data-next-card>
        <span class="next-label">Nächster Termin</span>
        <strong class="next-title" data-next-title>{{ naechster.titel }}</strong>
        <span class="next-date" data-next-date>{{ naechster.datum | datum }}{% if naechster.datum | uhrzeit %}, {{ naechster.datum | uhrzeit }}{% endif %}</span>
        <span class="next-countdown" data-countdown-out aria-live="polite"></span>
      </a>
      {% endif %}
    </div>
  </div>
</section>

{% if haupt %}
<section class="section">
  <div class="container feature feature--beitrag">
    <a class="feature-media{% if not haupt.data.bild %} feature-media--placeholder{% endif %}" href="{{ haupt.url }}" tabindex="-1" aria-hidden="true">
      {% if haupt.data.bild %}<img src="{{ haupt.data.bild }}" alt="" loading="lazy" decoding="async">{% else %}<img src="{{ site.logo }}" alt="" class="feature-logo">{% endif %}
    </a>
    <div class="feature-copy">
      <p class="kicker">Aktuelles · <time datetime="{{ haupt.date | iso }}">{{ haupt.date | datum }}</time></p>
      <h2><a href="{{ haupt.url }}">{{ haupt.data.title }}</a></h2>
      <p>{{ haupt.data.description or (haupt.content | excerpt(260)) }}</p>
      <a class="btn" href="{{ haupt.url }}">Weiterlesen</a>
    </div>
  </div>
</section>
{% elif kampagne.prinzenpaar.zeigen %}
<section class="section">
  <div class="container feature">
    <div class="feature-media{% if not kampagne.prinzenpaar.bild %} feature-media--placeholder{% endif %}">
      {% if kampagne.prinzenpaar.bild %}
        <img src="{{ kampagne.prinzenpaar.bild }}" alt="{{ kampagne.prinzenpaar.namen }}" loading="lazy" decoding="async">
      {% else %}
        <img src="{{ site.logo }}" alt="" class="feature-logo">
      {% endif %}
    </div>
    <div class="feature-copy">
      <p class="kicker">{{ kampagne.prinzenpaar.kicker or kampagne.titel }}</p>
      <h2>{{ kampagne.prinzenpaar.titel }}</h2>
      <p class="feature-names">{{ kampagne.prinzenpaar.namen }}</p>
      <p>{{ kampagne.prinzenpaar.text }}</p>
      {% if kampagne.prinzenpaar.link %}<a class="link-arrow" href="{{ kampagne.prinzenpaar.link }}">Zum Bericht</a>{% endif %}
    </div>
  </div>
</section>
{% endif %}

<section class="section section--tint">
  <div class="container">
    <div class="section-head">
      <h2>Kommende Termine</h2>
      <a class="link-arrow" href="/termine/">Kalender ansehen</a>
    </div>
    {% if kommend.length %}
    <ul class="event-list event-list--grid" data-termine data-termine-max="3">
      {% for t in kommend %}{% set kompakt = true %}{% set versteckt = loop.index > 3 %}{% include "partials/termin.njk" %}{% endfor %}
    </ul>
    <p class="empty-hint" data-termine-leer hidden>Der neue Veranstaltungsfahrplan folgt in Kürze.</p>
    {% else %}
    <p>Der neue Veranstaltungsfahrplan folgt in Kürze.</p>
    {% endif %}
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>Aktuelles</h2>
      <a class="link-arrow" href="/aktuelles/">Alle Beiträge</a>
    </div>
    <div class="card-grid">
      {% for post in collections.beitraege | ohne(haupt) | limit(3) %}
      {% include "partials/post-card.njk" %}
      {% endfor %}
    </div>
  </div>
</section>

<section class="section section--dark">
  <div class="container">
    <div class="section-head">
      <h2>Unsere Garden &amp; Gruppen</h2>
      <a class="link-arrow" href="/gruppen/">Alle Gruppen</a>
    </div>
    <ul class="chip-scroller" role="list">
      {% for g in gruppen %}
      <li class="chip-card">
        <a href="/gruppen/#{{ g.id }}">
          {% if g.bild %}<img src="{{ g.bild | thumb }}" alt="" loading="lazy" decoding="async" width="480" height="320">{% endif %}
          <span class="chip-text"><span class="chip-art">{{ g.art }}</span><strong>{{ g.name }}</strong></span>
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

<section class="section">
  <div class="container cta">
    <div>
      <h2>{{ startseite.aufruf.titel }}</h2>
      {% if startseite.aufruf.text %}<p>{{ startseite.aufruf.text }}</p>{% endif %}
    </div>
    {% if startseite.aufruf.knopf %}<a class="btn btn-accent" href="{{ startseite.aufruf.link or '/mitmachen/' }}">{{ startseite.aufruf.knopf }}</a>{% endif %}
  </div>
</section>

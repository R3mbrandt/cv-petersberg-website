---
layout: layouts/page.njk
title: Termine
kicker: Veranstaltungen am Petersberg
description: Alle Veranstaltungen, Vorverkäufe und Feiern des CVP auf einen Blick.
---
{%- set kommend = termine | termineSortiert("kommend") %}
<div class="calendar-actions">
  <a class="btn" href="/termine.ics" download>Alle Termine in den Kalender</a>
  <a class="btn btn-ghost" href="/termine.ics" data-webcal>Kalender abonnieren</a>
</div>
{% include "partials/kalender-abo-hinweis.njk" %}
{% if kommend.length %}
<ul class="event-list" data-termine>
  {% for t in kommend %}{% include "partials/termin.njk" %}{% endfor %}
</ul>
{% endif %}
<p class="empty-hint" data-termine-leer {% if kommend.length %}hidden{% endif %}>Aktuell stehen keine Termine an – der neue Veranstaltungsfahrplan folgt in Kürze.</p>

<p class="aktive-hinweis">Einmärsche und Auftritte unserer Aktiven: <a href="/aktive/#einmarschplan">zum Einmarschplan</a></p>


{%- for t in kommend %}
<script type="application/ld+json">
{%- set tag = t.datum | iso | truncate(10, true, "") -%}
{"@context":"https://schema.org","@type":"Event","name":{{ t.titel | json | safe }},"startDate":{{ t.datum | iso | json | safe }}
{%- if t.einlass %},"doorTime":{{ (tag + "T" + t.einlass) | json | safe }}{% endif %},"eventStatus":"https://schema.org/EventScheduled","eventAttendanceMode":"https://schema.org/OfflineEventAttendanceMode","location":{"@type":"Place","name":{{ (t.ort or site.kontakt.adresse.ort) | json | safe }},"address":{{ (t.adresse or site.kontakt.adresse.ort) | json | safe }}}
{%- set preis = t.eintritt | preis %}
{%- if preis == "0" %},"isAccessibleForFree":true{% elif preis %},"offers":{"@type":"Offer","price":{{ preis | json | safe }},"priceCurrency":"EUR","url":{{ (site.url + "/termine/") | json | safe }},"availability":"https://schema.org/InStock"}{% endif %},"description":{{ (t.beschreibung or t.titel) | json | safe }},"organizer":{"@type":"Organization","name":{{ site.name | json | safe }},"url":{{ site.url | json | safe }}}}
</script>
{%- endfor %}

BEGIN:VEVENT
UID:{{ t.titel | slugify }}-{{ t.datum | iso | replace(':', '') }}@{{ site.url | replace('https://', '') }}
DTSTAMP:20260101T000000Z
DTSTART{{ t.datum | icsDatum }}
DTEND{{ t.datum | icsEnde(t.ende) }}
SUMMARY:{{ t.titel | icsText | safe }}
{%- if t.ort or t.adresse %}
LOCATION:{{ ([t.ort, t.adresse] | select | join(", ")) | icsText | safe }}
{%- endif %}
{%- set info = [
  ("Einlass: " + t.einlass + " Uhr") if t.einlass else "",
  ("Eintritt: " + t.eintritt) if t.eintritt else "",
  t.beschreibung or "",
  site.name ] | select | join("\n") %}
DESCRIPTION:{{ info | icsText | safe }}
URL:{{ site.url }}/termine/
END:VEVENT

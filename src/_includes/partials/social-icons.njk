{#- Kleine Symbole für die Profile aus site.social (eigene SVGs, nichts wird nachgeladen) -#}
<ul class="{{ socialKlasse or 'social-icons' }}" role="list">
  {%- for s in site.social %}
  {%- set n = s.name | lower %}
  <li><a href="{{ s.url }}" rel="noopener" aria-label="{{ site.kurzname }} bei {{ s.name }}" title="{{ s.name }}">
    {%- if n == "instagram" %}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="17.3" cy="6.7" r="1.3" fill="currentColor"/></svg>
    {%- elif n == "facebook" %}<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path fill="currentColor" d="M13.3 21v-7h2.2l.35-2.6H13.3V9.85c0-.75.22-1.27 1.3-1.27h1.4V6.25c-.24-.03-1.07-.1-2.03-.1-2 0-3.37 1.22-3.37 3.45v1.8H8.4V14h2.2v7z"/></svg>
    {%- else %}<span>{{ s.name }}</span>{% endif -%}
  </a></li>
  {%- endfor %}
</ul>

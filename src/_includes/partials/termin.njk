{# Erwartet die Variable "t" (ein Termin aus termine.yaml) #}
<li class="event" data-datum="{{ t.datum | iso }}"{% if versteckt %} hidden{% endif %}>
  <time class="event-date" datetime="{{ t.datum | iso }}">
    <span class="event-weekday">{{ t.datum | datum("weekday") }}</span>
    <span class="event-day">{{ t.datum | datum("day") }}</span>
    <span class="event-month">{{ t.datum | datum("month") }}</span>
  </time>
  <div class="event-body">
    {% if t.kategorie %}<p class="event-cat">{{ t.kategorie }}</p>{% endif %}
    <h3 class="event-title">{{ t.titel }}</h3>
    <p class="event-meta">
      {%- set beginn = (t.datum | uhrzeit) | replace(" Uhr", "") %}
      {%- if t.einlass %}<span class="meta-time">Einlass {{ t.einlass }}{% if beginn %} · Beginn {{ beginn }}{% endif %} Uhr</span>
      {%- elif beginn %}<span class="meta-time">{{ beginn }}{% if t.ende %}–{{ t.ende }}{% endif %} Uhr</span>{% endif %}
      {%- if t.ort %}<span class="meta-place"><span>{{ t.ort }}{% if t.adresse and not kompakt %}, {{ t.adresse }}{% endif %}</span></span>{% endif %}
      {%- if t.eintritt %}<span class="meta-price">Eintritt: {{ t.eintritt }}</span>{% endif %}
    </p>
    {% if t.beschreibung and not kompakt %}<p class="event-text">{{ t.beschreibung }}</p>{% endif %}
    {% if not kompakt %}<a class="event-ics" href="/termine/{{ t.titel | slugify }}-{{ t.datum | iso | truncate(10, true, '') }}.ics" download>In meinen Kalender</a>{% endif %}
    {% if t.tickets %}<a class="btn btn-small" href="{{ t.tickets }}">Tickets</a>{% endif %}
  </div>
</li>

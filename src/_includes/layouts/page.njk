---
layout: layouts/base.njk
---
<header class="page-hero">
  <div class="container">
    {% if kicker %}<p class="kicker">{{ kicker }}</p>{% endif %}
    <h1>{{ title }}</h1>
    {% if description %}<p class="lead">{{ description }}</p>{% endif %}
  </div>
</header>
<div class="container {{ 'prose' if not breit }} section">
  {{ content | safe }}
</div>

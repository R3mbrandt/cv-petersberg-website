---
permalink: /.htaccess
eleventyExcludeFromCollections: true
---
# ------------------------------------------------------------------
#  Apache-Konfiguration für das OVH-Webhosting (wird automatisch erzeugt
#  aus src/htaccess.njk und src/_data/weiterleitungen.yaml)
# ------------------------------------------------------------------
AddDefaultCharset UTF-8
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType text/calendar .ics
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddCharset UTF-8 .ics .xml .webmanifest .css .js
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Weiterleitungen mit vollständiger Adresse (sonst hängt OVH ":443" an)

  # www.cv-petersberg.de -> cv-petersberg.de
  RewriteCond %{HTTP_HOST} ^www\.cv-petersberg\.de$ [NC]
  RewriteRule ^ {{ site.url }}%{REQUEST_URI} [R=301,L]

  # HTTP -> HTTPS (SSL-Zertifikate für cv-petersberg.de und www sind bei OVH aktiv)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ {{ site.url }}%{REQUEST_URI} [R=301,L]

  # Alte Adressen der WordPress-Seite (dauerhaft umgezogen)
{%- for w in weiterleitungen %}
  RewriteRule ^{{ w.von | htRegex | safe }}/?$ {{ site.url }}{{ w.nach | safe }} [R=301,NE,L]
{%- endfor %}

  # Kennzeichendatei des Uploads nicht ausliefern
  RewriteRule ^\.cvp-website$ - [R=404,L]

  # Alte WordPress-Pfade, die es nicht mehr gibt
  RewriteRule ^wp-content/uploads/(.*)$ {{ site.url }}/uploads/$1 [R=301,NE,L]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) - [R=410,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Content-Security-Policy: nur eigene Dateien; die zwei Inline-Blöcke im <head>
  # sind per Prüfsumme erlaubt (src/_data/inline.js). Der Redaktionsbereich /admin/
  # lädt Teile von externen Servern und bekommt daher keine CSP.
  <If "%{REQUEST_URI} !~ m#^/admin/#">
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' {{ inline.skriptHash | safe }}; style-src 'self' {{ inline.stilHash | safe }}; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; media-src 'self'; object-src 'none'; frame-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
  </If>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/calendar "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

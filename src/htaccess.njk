---
permalink: /.htaccess
eleventyExcludeFromCollections: true
---
# ------------------------------------------------------------------
#  Apache-Konfiguration für das OVH-Webhosting (wird automatisch erzeugt
#  aus src/htaccess.njk und src/_data/weiterleitungen.yaml)
# ------------------------------------------------------------------
AddDefaultCharset UTF-8
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_mime.c>
  AddType text/calendar .ics
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
  AddCharset UTF-8 .ics .xml .webmanifest .css .js
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.cv-petersberg.de -> cv-petersberg.de
  RewriteCond %{HTTP_HOST} ^www\.cv-petersberg\.de$ [NC]
  RewriteRule ^ https://cv-petersberg.de%{REQUEST_URI} [R=301,L]

  # HTTP -> HTTPS. Erst aktivieren, wenn im OVH-Kundencenter ein SSL-Zertifikat
  # für den Ordner aktiv ist (sonst droht eine Weiterleitungsschleife):
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Alte Adressen der WordPress-Seite (dauerhaft umgezogen)
{%- for w in weiterleitungen %}
  RewriteRule ^{{ w.von | htRegex | safe }}/?$ {{ w.nach | safe }} [R=301,NE,L]
{%- endfor %}

  # Alte WordPress-Pfade, die es nicht mehr gibt
  RewriteRule ^wp-content/uploads/(.*)$ /uploads/$1 [R=301,NE,L]
  RewriteRule ^(wp-admin|wp-login\.php|xmlrpc\.php) - [R=410,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/calendar "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

---
permalink: /manifest.webmanifest
eleventyExcludeFromCollections: true
---
{
  "name": {{ site.name | json | safe }},
  "short_name": {{ site.kurzname | json | safe }},
  "start_url": "{{ '/' | url }}",
  "display": "standalone",
  "lang": "de",
  "background_color": "#ffffff",
  "theme_color": {{ site.farben.primaer | json | safe }},
  "icons": [{ "src": "{{ '/assets/img/icon-192.png' | url }}", "sizes": "192x192", "type": "image/png" }]
}
